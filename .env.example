# Generate a personal token after ENTSO-E grants REST API access.
ENTSOE_API_TOKEN=
GRIDSCOPE_TIMEOUT_SECONDS=30
GRIDSCOPE_MAX_RETRIES=3
# In-memory response cache TTL, 0 disables it. Revisions appear after expiry.
GRIDSCOPE_CACHE_TTL_SECONDS=300

# Explicit provider selection: entsoe (token required) or smard (public).
GRIDSCOPE_PROVIDER=entsoe
# Optional append-only SQLite history. Uncomment to persist successful raw queries.
# GRIDSCOPE_STORAGE_PATH=data/gridscope.sqlite3
